{
  "name": "@boramarca/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start --no-interactive",
    "emulators": "firebase emulators:start --project barbershop-5dca2",
    "emulators:export": "firebase emulators:export .firebase-emulator-data",
    "e2e:seed": "firebase emulators:exec --only auth,firestore \"node functions/scripts/seed-detox-emulator.js\" --project barbershop-5dca2",
    "e2e:android": "firebase emulators:exec --only auth,firestore,functions \"node functions/scripts/seed-detox-emulator.js && detox test --configuration android.emu.debug\" --project barbershop-5dca2",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:rules": "firebase emulators:exec --only firestore,storage \"jest --config jest.rules.config.js --runInBand\" --project barbershop-5dca2",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@boramarca/core": "*",
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.3.21",
    "@supabase/supabase-js": "^2.58.0",
    "lucide-react-native": "^1.31.0",
    "react": "19.1.0",
    "react-native": "0.80.0",
    "react-native-contacts": "^8.0.5",
    "react-native-haptic-feedback": "^3.0.0",
    "react-native-image-picker": "^8.2.1",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^5.5.0",
    "react-native-screens": "^4.11.1",
    "react-native-svg": "^15.15.5",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.25.3",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.25.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@react-native-community/cli": "19.1.2",
    "@react-native-community/cli-platform-android": "19.1.2",
    "@react-native-community/cli-platform-ios": "19.1.2",
    "@react-native/babel-preset": "^0.80.1",
    "@react-native/eslint-config": "0.80.0",
    "@react-native/metro-config": "0.80.0",
    "@react-native/typescript-config": "0.80.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "babel-jest": "^29.7.0",
    "detox": "^20.40.0",
    "detox-cli": "^20.0.0",
    "eslint": "^8.19.0",
    "firebase-tools": "^15.27.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.0.4",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=18"
  }
}
