{
  "name": "@boramarca/mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint App.tsx supabaseConfig.ts src/v1",
    "start": "react-native start --no-interactive",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --runInBand --watchAll=false",
    "typecheck": "tsc --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify": "npm run check:boundaries && npm run typecheck && npm run lint && npm run test:ci"
  },
  "dependencies": {
    "@boramarca/core": "*",
    "@react-native-async-storage/async-storage": "^2.1.0",
